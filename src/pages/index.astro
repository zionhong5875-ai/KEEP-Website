---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import home from "../data/site/home.json";
import products from "../data/site/products.json";
import resources from "../data/site/resources.json";
import { text, attrs, htmlAttrs } from "../utils/i18n";
import { getProductLineHref, getProductLineMeta } from "../utils/productLines.js";

const companyStats = home.company.stats;
const rdMetrics = home.rd.metrics;

const metricIcons = {
  clock: ["M24 8a16 16 0 1 0 0 32 16 16 0 0 0 0-32Z", "M24 15v10l8 5", "M15 7l-5 6", "M33 7l5 6"],
  years: ["M24 7a17 17 0 1 0 17 17", "M24 14v11l8 5", "M24 7v6h6"],
  medical: ["M24 10v28", "M10 24h28", "M12 12h24v24H12z"],
  automation: ["M24 14v-5", "M24 39v-5", "M14 24H9", "M39 24h-5", "M17 17l-4-4", "M35 35l-4-4", "M31 17l4-4", "M13 35l4-4", "M24 17a7 7 0 1 0 0 14 7 7 0 0 0 0-14Z"],
  capacity: ["M8 39V22l10 7v-7l10 7V14h12v25H8Z", "M14 33h5", "M24 33h5", "M34 33h5"],
  investment: ["M8 38h32", "M12 32l8-10 7 6 10-16", "M33 12h8v8"],
  formula: ["M17 8h14", "M20 8v12L11 36c-1 2 0 4 3 4h20c3 0 4-2 3-4l-9-16V8", "M16 31h16"],
  network: ["M9 18h30L24 9 9 18Z", "M12 21h24", "M15 23v12", "M21 23v12", "M27 23v12", "M33 23v12", "M13 35h22", "M10 40h28", "M20 15h8"],
  patent: ["M14 7h17l7 7v27H14z", "M31 7v8h7", "M20 22h12", "M20 29h12", "M24 35l4 3 4-3"],
  lab: ["M15 8h18", "M19 8v10L11 36c-1 2 1 5 4 5h18c3 0 5-3 4-5l-8-18V8", "M16 30h16", "M22 18h4"]
};

const blogItems = resources.blogs;
const newsItems = resources.news;
---

<BaseLayout title={home.meta.title} description={home.meta.description}>
  <section class="hero" id="top" aria-labelledby="hero-title">
    <img class="hero-image" src={home.hero.image} alt={home.hero.alt} />
    <div class="hero-scrim"></div>
    <div class="hero-content">
      <p class="eyebrow" {...attrs(home.hero.eyebrow)}>{text(home.hero.eyebrow)}</p>
      <h1 id="hero-title" set:html={text(home.hero.title)} {...htmlAttrs(home.hero.title)} />
      <div class="hero-bottom">
        <p set:html={text(home.hero.body)} {...htmlAttrs(home.hero.body)} />
        <div class="button-row">
          <a class="button button-accent" href="#lines" data-zh="查看产品线" data-en="View product lines">查看产品线</a>
          <a class="button button-dark" href="#contact" data-zh="获取方案" data-en="Request a brief">获取方案</a>
        </div>
      </div>
    </div>
  </section>

  <section class="home-company section-pad" aria-labelledby="home-company-title">
    <div class="home-company-copy">
      <p class="section-kicker" {...attrs(home.company.kicker)}>{text(home.company.kicker)}</p>
      <h2 id="home-company-title" {...attrs(home.company.title)}>{text(home.company.title)}</h2>
      {home.company.paragraphs.map((paragraph) => (
        <p {...attrs(paragraph)}>{text(paragraph)}</p>
      ))}
    </div>

    <div class="home-company-video" aria-label="VINNER video">
      <iframe
        width="560"
        height="315"
        src={home.company.videoSrc}
        title={home.company.videoTitle}
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>
    </div>

    <div class="home-stat-groups" aria-label="VINNER key figures">
      {companyStats.map((item) => (
        <article class="home-stat-card">
          <span class="metric-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" focusable="false">
              {metricIcons[item.icon].map((path) => <path d={path} />)}
            </svg>
          </span>
          <div>
            <h3 {...attrs(item.label)}>{text(item.label)}</h3>
            <strong>{item.number}</strong>
            <p {...attrs(item.body)}>{text(item.body)}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="home-product-lines" id="lines" aria-labelledby="lines-title">
    <div class="home-section-heading">
      <p class="section-kicker" {...attrs(home.productLinesSection.kicker)}>{text(home.productLinesSection.kicker)}</p>
      <h2 id="lines-title" {...attrs(home.productLinesSection.title)}>{text(home.productLinesSection.title)}</h2>
    </div>

    <div class="product-line-tile-grid home-line-tile-grid">
      {products.lines.map((line) => {
        const meta = getProductLineMeta(line);
        return (
          <a class="product-line-tile" href={getProductLineHref(line)} aria-label={`View ${meta.brand}`}>
            <span class="product-line-tile-media" aria-hidden="true">
              <img src={meta.image} alt={meta.alt} loading="lazy" />
            </span>
            <span class="product-line-tile-copy">
              <span>{line.index}</span>
              <strong>{meta.brand}</strong>
              <em {...attrs(meta.title)}>{text(meta.title)}</em>
              <small {...attrs(home.productLinesSection.cta)}>{text(home.productLinesSection.cta)}</small>
            </span>
          </a>
        );
      })}
    </div>
  </section>

  <section class="home-rd" id="rd" aria-labelledby="rd-title">
    <div class="home-rd-copy">
      <p class="section-kicker" {...attrs(home.rd.kicker)}>{text(home.rd.kicker)}</p>
      <h2 id="rd-title" {...attrs(home.rd.title)}>{text(home.rd.title)}</h2>
      <p {...attrs(home.rd.body)}>{text(home.rd.body)}</p>
    </div>

    <div class="home-rd-metrics" aria-label="R&D metrics">
      {rdMetrics.map((metric) => (
        <article>
          <span class="metric-icon rd-metric-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" focusable="false">
              {metricIcons[metric.icon].map((path) => <path d={path} />)}
            </svg>
          </span>
          <div>
            <strong>{metric.number}</strong>
            <p {...attrs(metric.body)}>{text(metric.body)}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="home-insights" id="insights" aria-label="VINNER resources">
    <div class="home-insight-panel home-news-section" id="news" aria-labelledby="news-title">
      <div class="home-insight-heading">
        <p class="section-kicker" {...attrs(home.insights.news.kicker)}>{text(home.insights.news.kicker)}</p>
        <h2 id="news-title" {...attrs(home.insights.news.title)}>{text(home.insights.news.title)}</h2>
      </div>
      <div class="home-insight-scroll" data-scroll-region="x" tabindex="0" aria-label="首页新闻横向滚动列表">
        <div class="home-compact-article-grid">
          {newsItems.map((item) => (
            <article class="article-card home-compact-card">
              <a class="article-card-media-link" href={`/resources/${item.slug}/`} aria-label={`Read ${text(item.title)}`}>
                <figure><img src={item.image} alt={item.alt} loading="lazy" /></figure>
              </a>
              <div class="article-card-copy">
                <span>{item.date}</span>
                <h3><a href={`/resources/${item.slug}/`} {...attrs(item.title)}>{text(item.title)}</a></h3>
                <p {...attrs(item.body)}>{text(item.body)}</p>
                <a href={`/resources/${item.slug}/`} data-zh="阅读更新" data-en="Read update">阅读更新</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>

    <div class="home-insight-panel home-blog-section" id="blog" aria-labelledby="blog-title">
      <div class="home-insight-heading">
        <p class="section-kicker" {...attrs(home.insights.blog.kicker)}>{text(home.insights.blog.kicker)}</p>
        <h2 id="blog-title" {...attrs(home.insights.blog.title)}>{text(home.insights.blog.title)}</h2>
      </div>
      <div class="home-insight-scroll" data-scroll-region="x" tabindex="0" aria-label="首页博客横向滚动列表">
        <div class="home-compact-article-grid home-compact-article-grid-blog">
          {blogItems.map((item) => (
            <article class="article-card home-compact-card">
              <a class="article-card-media-link" href={`/resources/${item.slug}/`} aria-label={`Read ${text(item.title)}`}>
                <figure><img src={item.image} alt={item.alt} loading="lazy" /></figure>
              </a>
              <div class="article-card-copy">
                <span>{item.category}</span>
                <h3><a href={`/resources/${item.slug}/`} {...attrs(item.title)}>{text(item.title)}</a></h3>
                <p {...attrs(item.body)}>{text(item.body)}</p>
                <a href={`/resources/${item.slug}/`} data-zh="阅读文章" data-en="Read article">阅读文章</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="partner-section home-partner-section" id="partners" aria-labelledby="partners-title">
    <div class="about-section-heading">
      <p class="section-kicker" {...attrs(home.partners.kicker)}>{text(home.partners.kicker)}</p>
      <h2 id="partners-title" {...attrs(home.partners.title)}>{text(home.partners.title)}</h2>
    </div>
    <div class="partner-wall" aria-label="Partner brands">
      {home.partners.items.map((partner) => (
        <span>
          <img src={partner.logo} alt={partner.name} loading="lazy" />
        </span>
      ))}
    </div>
  </section>

  <ContactForm />
</BaseLayout>
