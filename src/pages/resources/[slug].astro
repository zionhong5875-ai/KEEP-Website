---
import BaseLayout from "../../layouts/BaseLayout.astro";
import resources from "../../data/site/resources.json";
import { text, attrs } from "../../utils/i18n";

export const prerender = true;

export function getStaticPaths() {
  const entries = [
    ...resources.news.map((item) => ({ item, type: { zh: "新闻", en: "News" }, meta: item.date })),
    ...resources.blogs.map((item) => ({ item, type: { zh: "博客", en: "Blog" }, meta: item.category }))
  ];

  return entries.map((entry) => ({
    params: { slug: entry.item.slug },
    props: {
      ...entry,
      related: entries.filter((candidate) => candidate.item.slug !== entry.item.slug).slice(0, 3)
    }
  }));
}

const { item, type, meta, related } = Astro.props;
const title = {
  zh: `${text(item.title)} | VINNER`,
  en: `${text(item.title)} | VINNER`
};
const description = item.body;
const articleParagraphs = [item.body, ...item.sections.map((section) => section.body)];
const gallery = Array.isArray(item.gallery) ? item.gallery : [];
const hasRichSections = item.sections.some((section) => Array.isArray(section.media) && section.media.length > 0);
const relatedTitle = type.zh === "博客"
  ? { zh: "更多博客。", en: "More blog posts." }
  : { zh: "更多新闻。", en: "More news." };
---

<BaseLayout title={title} description={description}>
  <article class="resource-detail">
    <header class="resource-detail-hero">
      <div class="resource-detail-copy">
        <a class="back-link" href="/resources/" data-zh="返回博客与资源" data-en="Back to resources">返回博客与资源</a>
        <p class="section-kicker" {...attrs(type)}>{text(type)}</p>
        <h1 {...attrs(item.title)}>{text(item.title)}</h1>
        <p class="resource-detail-meta">{meta}</p>
        <p class="resource-detail-summary" {...attrs(item.body)}>{text(item.body)}</p>
      </div>
      <figure class="resource-detail-image">
        <img src={item.image} alt={item.alt} />
      </figure>
    </header>

    <section class="resource-article-body resource-article-story" id="article" aria-label="Article body">
      <div class="resource-article-content">
        {hasRichSections ? (
          <>
            <p class="resource-article-lead" {...attrs(item.body)}>{text(item.body)}</p>
            {item.sections.map((section) => (
              <section class="resource-day-entry">
                <div class="resource-day-copy">
                  <h2 {...attrs(section.heading)}>{text(section.heading)}</h2>
                  <p {...attrs(section.body)}>{text(section.body)}</p>
                </div>
                {Array.isArray(section.media) && section.media.length > 0 && (
                  <div class="resource-day-media">
                    {section.media.map((media) => (
                      <figure>
                        <img src={media.image} alt={media.alt} />
                        <figcaption {...attrs(media.caption)}>{text(media.caption)}</figcaption>
                      </figure>
                    ))}
                  </div>
                )}
              </section>
            ))}
          </>
        ) : (
          articleParagraphs.map((paragraph) => (
            <p {...attrs(paragraph)}>{text(paragraph)}</p>
          ))
        )}
      </div>
    </section>

    {gallery.length > 0 && (
      <section class="resource-article-gallery" aria-label="Article gallery">
        {gallery.map((media) => (
          <figure>
            <img src={media.image} alt={media.alt} />
            <figcaption {...attrs(media.caption)}>{text(media.caption)}</figcaption>
          </figure>
        ))}
      </section>
    )}
  </article>

  <section class="product-detail-section related-products resource-related-section" aria-labelledby="related-resources-title">
    <div class="detail-split-heading">
      <p class="section-kicker" data-zh="继续阅读" data-en="Keep reading">继续阅读</p>
      <h2 id="related-resources-title" {...attrs(relatedTitle)}>{text(relatedTitle)}</h2>
    </div>
    <div class="related-resource-grid">
      {related.map((entry) => (
        <a class="related-resource-card" href={`/resources/${entry.item.slug}/`}>
          <figure><img src={entry.item.image} alt={entry.item.alt} /></figure>
          <span>{entry.meta}</span>
          <strong {...attrs(entry.item.title)}>{text(entry.item.title)}</strong>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
