---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GlossaryBrowser from "../../../components/GlossaryBrowser.astro";
import GlossaryParagraphs from "../../../components/GlossaryParagraphs.astro";
import MediaCaption from "../../../components/MediaCaption.astro";
import { searchConfig } from "../../../utils/search-config.mjs";
import { glossaryMetaDescription, publishedTerms, glossaryTerms, glossaryCategories, glossaryPath } from "../../../utils/glossary.mjs";
import backlinks from "../../../generated/glossary-backlinks.json";
import { absoluteUrl } from "../../../utils/schema";
import { localizedPath } from "../../../utils/i18n";
const term = publishedTerms.find(item => item.slug === Astro.params.slug);
if (!term) return new Response("Glossary term not found", { status: 404 });
const language = Astro.locals.language === "en" ? "en" : "zh";
const en = language === "en";
const t = (zh: string, english: string) => en ? english : zh;
const category = glossaryCategories.find(item => item.id === term.category)!;
const relatedPages = backlinks[language][term.slug] || [];
const siteUrl = searchConfig.siteUrl;
const pageUrl = absoluteUrl(localizedPath(glossaryPath(term.slug), language), siteUrl);
const termId = `${pageUrl}#defined-term`;
const termSetUrl = absoluteUrl(localizedPath("/resources/glossary/", language), siteUrl);
const termSchema = {
  "@type": "DefinedTerm",
  "@id": termId,
  name: term.title[language],
  alternateName: [...new Set([term.title.zh, term.title.en])],
  description: glossaryMetaDescription(term, language),
  url: pageUrl,
  inLanguage: language === "en" ? "en" : "zh-CN",
  inDefinedTermSet: { "@id": `${termSetUrl}#glossary` },
  termCode: term.slug,
  ...(relatedPages.length ? { subjectOf: relatedPages.map(page => ({ "@id": `${absoluteUrl(page.href, siteUrl)}#webpage` })) } : {})
};
---
<BaseLayout
  title={{zh: `${term.title.zh} | VINNER`, en: `${term.title.en} | Glossary | VINNER`}}
  description={{zh: glossaryMetaDescription(term, "zh"), en: glossaryMetaDescription(term, "en")}}
  image={term.illustration?.src || "/assets/resource-library.jpg"}
  pageType="ItemPage"
  mainEntityId={termId}
  schema={[termSchema]}
  breadcrumbs={[
    {name:{zh:"首页",en:"Home"},path:"/"},
    {name:{zh:"资源",en:"Resources"},path:"/resources/"},
    {name:{zh:"知识与术语",en:"Glossary"},path:"/resources/glossary/"},
    {name:term.title,path:glossaryPath(term.slug)}
  ]}
>
  <div class="term-page">
    <nav class="term-breadcrumb" aria-label={t("面包屑导航", "Breadcrumb")}>
      <a href="/resources/glossary/">← {t("知识与术语", "Glossary")}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{term.title[language]}</span>
    </nav>
    <article class="term-content" aria-labelledby="term-title">
      <header>
        <a class="term-kicker" href={`/resources/glossary/?category=${term.category}`}>{category[language]}</a>
        <h1 id="term-title">{term.title[language]}</h1>
        {!en && term.title.zh !== term.title.en && <p class="term-subtitle">{term.title.en}</p>}
      </header>
      <section aria-labelledby="definition-title">
        <h2 id="definition-title">{t("定义", "Definition")}</h2>
        <GlossaryParagraphs paragraphs={term.definition[language]} />
      </section>
      {term.illustration && (
        <figure class="term-illustration">
          <img
            src={term.illustration.src}
            alt={term.illustration.alt[language]}
            loading="lazy"
            width="1270"
            height="847"
          />
          <MediaCaption caption={term.illustration.caption} />
        </figure>
      )}
      {term.showImportance !== false && <section aria-labelledby="importance-title">
        <h2 id="importance-title">{t("为什么重要？", "Why does it matter?")}</h2>
        <GlossaryParagraphs paragraphs={term.importance[language]} />
      </section>}
      <section class="term-references" aria-labelledby="references-title">
        <h2 id="references-title">{t("参考文献", "References")}</h2>
        <ol>
          {term.references.map((reference, i) => <li id={`reference-${i + 1}`}><span>[{i + 1}]</span><span>{reference.replace(/^\[\d+\]\s*/, "")}</span></li>)}
        </ol>
      </section>
    </article>
    <section class="term-related" data-related-pages aria-labelledby="related-title">
      <div class="module-heading">
        <h2 id="related-title">{t("以下页面提到该术语", "Pages that mention this term")}</h2>
        {relatedPages.length > 0 && <div class="carousel-controls">
          <button type="button" data-direction="-1" aria-label={t("上一个相关页面", "Previous related page")} aria-controls="related-track" disabled>←</button>
          <button type="button" data-direction="1" aria-label={t("下一个相关页面", "Next related page")} aria-controls="related-track" disabled>→</button>
        </div>}
      </div>
      {relatedPages.length ? <div class="related-track" id="related-track" tabindex="0" role="region" aria-label={t("相关页面，可横向滚动", "Related pages, scroll horizontally")}>
        {relatedPages.map(page => <a class="glossary-related-card" href={page.href}>
          <div class="related-image"><img src={page.image} alt={page.title} loading="lazy" width="720" height="480" /></div>
          <div class="related-copy"><h3>{page.title} <span aria-hidden="true">↗</span></h3><p>{page.description}</p></div>
        </a>)}
      </div> : <p class="term-related-empty">{t("尚无页面提及该术语，但该术语仍是重要概念。", "No pages mention this term yet, but it remains an important concept.")}</p>}
    </section>
    <section class="term-other" aria-labelledby="other-title">
      <div class="module-heading">
        <h2 id="other-title">{t("其他知识与术语", "Other Glossary Terms")}</h2>
        <a href="/resources/glossary/">{t("所有术语", "All terms")} ↗</a>
      </div>
      <div class="other-list"><GlossaryBrowser terms={glossaryTerms} defaultCategory={term.category} /></div>
    </section>
  </div>
</BaseLayout>
<script>
  for (const section of document.querySelectorAll<HTMLElement>("[data-related-pages]")) {
    const track = section.querySelector<HTMLElement>(".related-track")!;
    if (!track) continue;
    const buttons = [...section.querySelectorAll<HTMLButtonElement>("button[data-direction]")];
    const update = () => buttons.forEach(button => {
      button.disabled = button.dataset.direction === "-1" ? track.scrollLeft <= 1 : track.scrollLeft >= track.scrollWidth - track.clientWidth - 1;
    });
    buttons.forEach(button => button.addEventListener("click", () => track.scrollBy({left: Number(button.dataset.direction) * track.clientWidth * .85, behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "instant" : "smooth"})));
    track.addEventListener("scroll", update, {passive:true});
    new ResizeObserver(update).observe(track);
    update();
  }
</script>
<style>
  .term-page { max-width:1600px; margin:auto; padding:140px 5% 100px; }
  .term-breadcrumb { display:flex; align-items:center; flex-wrap:wrap; gap:18px; padding:18px 0; border-block:1px solid #d2d6d7; font-size:14px; color:var(--color-slate-mist); }
  .term-breadcrumb a { color:var(--color-obsidian); }
  .term-content { max-width:820px; padding:64px 0 80px; }
  .term-kicker { font-size:13px; font-weight:700; letter-spacing:.04em; color:#007c7a; }
  .term-content h1 { font-size:clamp(40px,5.5vw,76px); line-height:1.12; letter-spacing:-.02em; text-wrap:balance; margin:22px 0; overflow-wrap:anywhere; }
  .term-subtitle { font-size:20px; color:var(--color-slate-mist); line-height:1.5; margin:0; }
  .term-content section { margin-top:44px; }
  .term-illustration { display:grid; gap:12px; margin:44px 0 0; }
  .term-illustration img { width:100%; height:auto; display:block; }
  .term-illustration .site-image-caption { color:var(--color-slate-mist); font-size:clamp(14px, 1vw, 16px); line-height:1.45; }
  .term-content h2 { font-size:26px; line-height:1.3; margin:0 0 20px; }
  .term-references ol { list-style:none; padding:0; margin:0; }
  .term-references li { display:grid; grid-template-columns:28px minmax(0,1fr); gap:8px; margin-bottom:14px; font-size:14px; line-height:1.75; color:var(--color-slate-mist); overflow-wrap:anywhere; scroll-margin-top:120px; }
  .term-references li:target { background:#edf8f7; }
  .term-related,.term-other { border-top:1px solid #d2d6d7; padding-top:56px; margin-bottom:72px; }
  .module-heading { display:flex; justify-content:space-between; align-items:center; gap:24px; margin-bottom:32px; }
  .module-heading h2 { font-size:clamp(28px,3vw,42px); line-height:1.25; margin:0; }
  .module-heading > a { flex-shrink:0; font-size:14px; text-decoration:underline; text-underline-offset:5px; }
  .carousel-controls { display:flex; gap:10px; }
  .carousel-controls button { width:44px; height:44px; border:1px solid #a8b1b3; border-radius:50%; background:transparent; font-size:20px; cursor:pointer; }
  .carousel-controls button:disabled { opacity:.3; cursor:default; }
  .carousel-controls button:not(:disabled):hover { background:var(--color-tiffany-blue); }
  .related-track { display:flex; gap:24px; overflow-x:auto; scroll-snap-type:x mandatory; padding:4px 4px 20px; margin-inline:-4px; }
  .glossary-related-card { flex:0 0 380px; max-width:90%; scroll-snap-align:start; border:1px solid #d2d6d7; transition:border-color .2s; }
  .glossary-related-card:hover { border-color:#007c7a; }
  .related-image { aspect-ratio:3/2; overflow:hidden; background:#eef2f1; }
  .related-image img { width:100%; height:100%; object-fit:cover; }
  .related-copy { padding:24px; }
  .related-copy h3 { display:flex; justify-content:space-between; gap:16px; font-size:26px; line-height:1.2; margin:14px 0; }
  .related-copy p { font-size:15px; line-height:1.65; color:var(--color-slate-mist); margin:0; }
  .other-list { width:100%; }
  .term-page a:focus-visible,.term-page button:focus-visible,.related-track:focus-visible { outline:2px solid var(--color-tiffany-blue); outline-offset:4px; }
  @media(max-width:640px) { .term-page {padding:110px 6% 48px;} .term-breadcrumb {font-size:12px;gap:12px;} .term-content {padding:40px 0 48px;} .term-subtitle {font-size:17px;} .term-content h2 {font-size:23px;} .term-content section {margin-top:32px;} .term-related,.term-other {padding-top:32px;margin-bottom:40px;} .module-heading {gap:16px;align-items:flex-start;} .module-heading h2 {font-size:26px;} .carousel-controls {gap:6px;} .carousel-controls button {width:36px;height:36px;} .glossary-related-card {flex-basis:300px;} .related-copy {padding:20px;} .related-copy h3 {font-size:23px;} }
</style>
