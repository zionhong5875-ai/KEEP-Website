---
import { searchConfig } from "../../utils/search-config.mjs";
import BaseLayout from "../../layouts/BaseLayout.astro";
import GlossaryLinkedText from "../../components/GlossaryLinkedText.astro";
import products from "../../data/site/products.json" with { type: "json" };
import { text, attrs, localizedPath } from "../../utils/i18n";
import { getProductLineMeta } from "../../utils/productLines";
import { isDirectDownloadResource, sortResourcesByAccessAndName } from "../../utils/resources.js";
import { absoluteUrl, productBrandName, schemaIds } from "../../utils/schema";

const entry = products.lines.flatMap((line) =>
  line.skus.filter((sku) => !sku.comingSoon).map((sku) => ({
    line,
    sku,
    related: line.skus.filter((item) => item.slug !== sku.slug && !item.comingSoon)
  }))
).find(({ sku }) => sku.slug === Astro.params.slug);

if (!entry) {
  return new Response("Product not found", { status: 404 });
}

const { line, sku, related } = entry;
const lineMeta = getProductLineMeta(line);
const pageTitle = {
  zh: `${sku.title} | VINNER`,
  en: `${sku.title} | VINNER`
};
const pageDescription = {
  zh: sku.intro?.zh || sku.body.zh,
  en: sku.body?.en || sku.intro.en
};
const specLabel = (spec) => text(Array.isArray(spec) ? spec[0] : spec.label);
const specValue = (spec) => text(Array.isArray(spec) ? spec[1] : spec.value);
const gallery = sku.gallery?.length ? sku.gallery : [{ image: sku.image, alt: sku.alt }];
const galleryTotal = gallery.length;
const availableResources = sortResourcesByAccessAndName(sku.downloads || []);
const relatedProducts = related.slice(0, 3);
const relatedLineTitle = {
  zh: lineMeta.name.zh,
  en: lineMeta.name.en
};
const siteUrl = searchConfig.siteUrl;
const language = Astro.locals.language || "zh";
const ids = schemaIds(siteUrl);
const pageUrl = absoluteUrl(localizedPath(`/products/${sku.slug}/`, language), siteUrl);
const productId = `${pageUrl}#product`;
const productSchema = {
  "@type": "Product",
  "@id": productId,
  name: sku.title,
  sku: sku.itemNo || sku.code,
  brand: {
    "@type": "Brand",
    name: productBrandName(sku.code, sku.title)
  },
  manufacturer: { "@id": ids.organization },
  category: text(lineMeta.name, language),
  description: text(pageDescription, language),
  image: gallery.map((image) => absoluteUrl(image.image, siteUrl)),
  url: pageUrl,
  mainEntityOfPage: { "@id": `${pageUrl}#webpage` },
  additionalProperty: sku.specs.map((spec) => ({
    "@type": "PropertyValue",
    name: text(Array.isArray(spec) ? spec[0] : spec.label, language),
    value: text(Array.isArray(spec) ? spec[1] : spec.value, language)
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image={gallery[0]?.image || sku.image}
  ogType="product"
  pageType="ItemPage"
  breadcrumbs={[
    { name: { zh: "首页", en: "Home" }, path: "/" },
    { name: { zh: "产品", en: "Products" }, path: "/products/" },
    { name: lineMeta.name, path: `/products/series/${lineMeta.slug}/` },
    { name: { zh: sku.title, en: sku.title }, path: `/products/${sku.slug}/` }
  ]}
  mainEntityId={productId}
  schema={productSchema}
>
  <section class="product-detail-hero" aria-labelledby="product-title">
    <div class="product-detail-copy">
      <a class="back-link" href="/products/" data-zh="返回产品页" data-en="Back to products">返回产品页</a>
      <p class="section-kicker" {...attrs(lineMeta.indexLabel)}>{text(lineMeta.indexLabel)}</p>
      <h1 id="product-title">{sku.title}</h1>
      <p class="product-code">
        <span>{sku.code}</span>
        <span>{sku.itemNo}</span>
      </p>
      <p class="product-intro"><GlossaryLinkedText value={sku.intro} context="hero" /></p>
      <div class="button-row">
        {availableResources.length > 0 && (
          <a class="button button-accent" href="/contact/" data-zh="联系我们获取资料" data-en="Contact us to request resources">联系我们获取资料</a>
        )}
        <a class="button button-dark" href="/contact/" data-zh="咨询方案" data-en="Request a brief">咨询方案</a>
      </div>
    </div>
    <div class="product-gallery" data-product-carousel aria-label="Product images">
      <div class="product-gallery-main" tabindex="0">
        <div class="product-gallery-track">
          {gallery.map((image, index) => (
            <figure class:list={["product-gallery-slide", index === 0 && "is-active"]}>
              <img src={image.image} alt={image.alt} />
            </figure>
          ))}
        </div>
        <div class="gallery-controls product-gallery-controls" data-aria-label-zh="产品图片轮播控制" data-aria-label-en="Product image carousel controls" aria-label="产品图片轮播控制">
          <button type="button" class="gallery-arrow" data-product-prev data-aria-label-zh="上一张产品图" data-aria-label-en="Previous product image" aria-label="上一张产品图">
            <svg viewBox="0 0 72 48" aria-hidden="true" focusable="false"><path d="M64 24H10M25 8 9 24l16 16"></path></svg>
          </button>
          <button type="button" class="gallery-arrow gallery-arrow-next" data-product-next data-aria-label-zh="下一张产品图" data-aria-label-en="Next product image" aria-label="下一张产品图">
            <svg viewBox="0 0 72 48" aria-hidden="true" focusable="false"><path d="M8 24h54M47 8l16 16-16 16"></path></svg>
          </button>
          <span class="gallery-count" aria-live="polite"><b data-product-current>1</b>/{galleryTotal}</span>
        </div>
      </div>
      <div class="product-thumbnails" role="list" data-aria-label-zh="产品图片缩略图" data-aria-label-en="Product image thumbnails" aria-label="产品图片缩略图">
        {gallery.map((image, index) => (
          <button class:list={["product-thumbnail", index === 0 && "is-active"]} type="button" data-product-thumb={index} aria-label={`Show product image ${index + 1}`}>
            <img src={image.image} alt="" />
          </button>
        ))}
      </div>
    </div>
  </section>

  <section class="product-detail-section product-detail-overview" aria-labelledby="overview-title">
    <div class="detail-section-heading">
      <h2 id="overview-title" class="detail-section-label" data-zh="产品定位" data-en="Product position">产品定位</h2>
    </div>
    <div class="detail-highlight-grid">
      {sku.highlights.map((highlight) => (
        <article>
          <span class="highlight-icon" aria-hidden="true">+</span>
          <p><GlossaryLinkedText value={highlight} context="feature" /></p>
        </article>
      ))}
    </div>
  </section>

  <section class="product-detail-section product-spec-block" aria-labelledby="spec-title">
    <div class="detail-section-heading">
      <h2 id="spec-title" class="detail-section-label" data-zh="规格与结构" data-en="Format & build">规格与结构</h2>
    </div>
    <dl class="detail-spec-list">
      {sku.specs.map((spec) => (
        <div>
        <dt><GlossaryLinkedText value={Array.isArray(spec) ? spec[0] : spec.label} context="label" /></dt>
        <dd><GlossaryLinkedText value={Array.isArray(spec) ? spec[1] : spec.value} context="spec" /></dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="product-detail-section usage-section" aria-labelledby="usage-title">
    <div class="detail-section-heading">
      <h2 id="usage-title" class="detail-section-label" data-zh="使用流程" data-en="Use protocol">使用流程</h2>
    </div>
    <ol class="usage-steps">
      {sku.usage.map((step, index) => (
        <li>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <h3 class="sr-only" data-zh={`步骤 ${index + 1}`} data-en={`Step ${index + 1}`}>步骤 {index + 1}</h3>
          <p><GlossaryLinkedText value={step} context="paragraph" /></p>
        </li>
      ))}
    </ol>
  </section>

  {availableResources.length > 0 && (
    <section class="product-detail-section download-panel" id="resources" aria-labelledby="downloads-title">
      <div class="detail-section-heading">
        <h2 id="downloads-title" class="detail-section-label" data-zh="资料获取" data-en="Resource access">资料获取</h2>
      </div>
      <div class="download-card-grid">
        {availableResources.map((download) => (
          <a class="download-card" href={isDirectDownloadResource(download) ? download.href : "/contact/"} {...(isDirectDownloadResource(download) ? { download: true } : {})}>
            <span>{download.type}</span>
            <strong {...attrs(download.title)}>{text(download.title)}</strong>
            <small
              data-zh={isDirectDownloadResource(download) ? "下载 Brochure" : "联系我们获取"}
              data-en={isDirectDownloadResource(download) ? "Download brochure" : "Contact us to request"}
            >
              {isDirectDownloadResource(download) ? "下载 Brochure" : "联系我们获取"}
            </small>
          </a>
        ))}
      </div>
    </section>
  )}

  {relatedProducts.length > 0 && (
    <section class="product-detail-section related-products product-related-section" aria-labelledby="related-title">
      <div class="detail-split-heading">
        <p class="section-kicker" data-zh="相关产品" data-en="Related products">相关产品</p>
        <h2 id="related-title" {...attrs(relatedLineTitle)}>{text(relatedLineTitle)}</h2>
      </div>
      <div class="related-grid">
        {relatedProducts.map((item) => (
          <a class="related-card" href={`/products/${item.slug}/`}>
            <figure>
              <img src={item.image} alt={item.alt} />
            </figure>
            <span>{item.code}</span>
            <h3>{item.title}</h3>
            <p {...attrs(item.body)}>{text(item.body)}</p>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
