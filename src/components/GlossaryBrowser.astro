---
import { glossaryCategories, glossaryPath } from "../utils/glossary.mjs";
import { glossaryHeading } from "../utils/glossary-heading.mjs";
const { terms, showFilters = true, defaultCategory } = Astro.props;
const language = Astro.locals.language === "en" ? "en" : "zh";
const en = language === "en";
const t = (zh: string, english: string) => en ? english : zh;

const categories = glossaryCategories.map(category => ({id: category.id, name: category[language]}));
const requestedCategory = defaultCategory ?? Astro.url.searchParams.get("category");
const selectedCategory = categories.find(category => category.id === requestedCategory);
const selectedId = selectedCategory?.id || "all";
const heading = glossaryHeading(language, selectedCategory?.name);
const initialCount = terms.filter(term => selectedId === "all" || term.category === selectedId).length;
---
    <div class:list={["glossary-layout", {"without-filters": !showFilters}]} data-glossary data-language={en ? "en" : "zh"}>
      <div class="glossary-results">
        <label class="glossary-search"><span>{t("搜索术语", "Search terms")}</span><input type="search" placeholder={t("搜索名称、释义或英文术语", "Search names or definitions")} autocomplete="off" /></label>
        <div class="glossary-summary"><h2 data-results-heading aria-live="polite" aria-atomic="true">{heading}</h2><output aria-live="polite" aria-atomic="true">{initialCount} {t("个术语", initialCount === 1 ? "term" : "terms")}</output></div>
        
        <ul class="glossary-list">
          {terms.map(term => <li hidden={selectedId !== "all" && term.category !== selectedId} data-term data-category={term.category} data-letter={term.title.en[0].toUpperCase()} data-search={`${term.title.en} ${term.title.zh} ${term.summary.en} ${term.summary.zh}`.toLowerCase()}>
            <div>
              <h3>{term.slug ? <a href={glossaryPath(term.slug)}>{term.title[language]} <span aria-hidden="true">↗</span></a> : term.title[language]}</h3>
              {!en && term.title.zh !== term.title.en && <span class="term-english">{term.title.en}</span>}
              <p>{term.summary[language]}</p>
              {term.sample && <small>{t("示例术语 · 详情待补充", "Sample term · Details coming soon")}</small>}
            </div>
            <span class="term-category">{categories.find(item => item.id === term.category)?.name}</span>
          </li>)}
        </ul>
        <p class="glossary-empty" hidden>{t("没有匹配的术语，请调整搜索条件。", "No matching terms. Try another search.")}</p>
      </div>
      {showFilters && <aside class="glossary-filters" aria-label={t("术语筛选", "Term filters")}>
        <div class="filter-heading"><h2>{t("筛选", "Filters")}</h2><button type="button" data-reset>{t("重置", "Reset")}</button></div>
        <fieldset><legend>{t("分类", "Categories")}</legend>
          <label><input type="radio" name="category" value="all" checked={selectedId === "all"} />{t("所有分类", "All categories")}</label>
          {categories.map(category => <label><input type="radio" name="category" value={category.id} data-category-name={category.name} checked={selectedId === category.id} />{category.name}</label>)}
        </fieldset>
        <fieldset><legend>{t("英文首字母", "Alphabet")}</legend><div class="glossary-alphabet">
          <button type="button" data-letter="all" aria-pressed="true">{t("全部", "All")}</button>
          {"ABCDEFGHIJKLMNOPQRSTUVWXYZ".split("").map(letter => <button type="button" data-letter={letter} aria-pressed="false">{letter}</button>)}
        </div></fieldset>
      </aside>}
    </div>
<script>
  import { glossaryHeading } from "../utils/glossary-heading.mjs";
  for (const root of document.querySelectorAll<HTMLElement>("[data-glossary]")) {
    const search = root.querySelector<HTMLInputElement>('input[type="search"]')!;
    const rows = [...root.querySelectorAll<HTMLElement>("[data-term]")];
    const letters = [...root.querySelectorAll<HTMLButtonElement>("button[data-letter]")];
    const radios = [...root.querySelectorAll<HTMLInputElement>('input[name="category"]')];
    let initial = "all";
    const update = () => {
      const category = radios.find(input => input.checked)?.value || "all";
      const categoryName = radios.find(input => input.checked)?.dataset.categoryName;
      root.querySelector("[data-results-heading]")!.textContent = glossaryHeading(root.dataset.language, categoryName, initial);
      const words = search.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      let count = 0;
      rows.forEach(row => {
        const match = (category === "all" || row.dataset.category === category) && (initial === "all" || row.dataset.letter === initial) && words.every(word => row.dataset.search?.includes(word));
        row.hidden = !match;
        if (match) count++;
      });
      root.querySelector("output")!.textContent = `${count} ${root.dataset.language === "en" ? (count === 1 ? "term" : "terms") : "个术语"}`;
      root.querySelector<HTMLElement>(".glossary-empty")!.hidden = count !== 0;
      letters.forEach(button => button.setAttribute("aria-pressed", String(button.dataset.letter === initial)));
    };
    update();
    search.addEventListener("input", update);
    radios.forEach(input => input.addEventListener("change", update));
    letters.forEach(button => button.addEventListener("click", () => { initial = button.dataset.letter!; update(); }));
    root.querySelector("[data-reset]")?.addEventListener("click", () => { search.value = ""; if (radios[0]) radios[0].checked = true; initial = "all"; update(); });
  }
</script>
<style>
  .glossary-layout { display: grid; grid-template-columns: minmax(0,1fr) 290px; gap: 80px; align-items: start; }
  .glossary-search { display: grid; gap: 12px; font-size: 15px; font-weight: 700; }
  .glossary-search input { width: 100%; height: 56px; border: 1px solid #a8b1b3; border-radius: 0; background: white; padding: 12px 16px; font: inherit; font-weight: 400; }
  .glossary-layout input:focus-visible, .glossary-layout button:focus-visible { outline: 2px solid var(--color-tiffany-blue); outline-offset: 3px; }
  .glossary-summary, .filter-heading { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .glossary-summary { margin-top: 36px; align-items: baseline; }
  .glossary-summary output { flex-shrink: 0; }
  .glossary-layout h2 { font-size: 24px; line-height: 1.3; margin: 0; }
  .glossary-layout output, .glossary-sample { font-size: 13px; color: var(--color-slate-mist); }
  .glossary-sample { margin: 12px 0 20px; }
  .glossary-list { list-style: none; padding: 0; margin: 0; }
  .glossary-list li { display: grid; grid-template-columns: minmax(0,1fr) 145px; gap: 24px; padding: 28px 0; border-top: 1px solid #d2d6d7; }
  .glossary-list li[hidden], .glossary-empty[hidden] { display: none; }
  .glossary-layout h3 { font-size: 26px; line-height: 1.3; margin: 0 0 8px; overflow-wrap: anywhere; }
  .term-english { font-size: 14px; color: var(--color-slate-mist); }
  .glossary-list p { font-size: 16px; line-height: 1.6; margin: 12px 0 0; color: var(--color-slate-mist); }
  .term-category { font-size: 12px; line-height: 1.5; color: #007c7a; padding-top: 7px; }
  .glossary-filters { position: sticky; top: 110px; }
  .filter-heading { padding-bottom: 24px; border-bottom: 1px solid #d2d6d7; }
  .filter-heading button { background: none; border: 0; border-bottom: 1px solid; padding: 4px 0; font: inherit; cursor: pointer; }
  .glossary-layout fieldset { border: 0; margin: 26px 0 0; padding: 0; min-width: 0; }
  .glossary-layout legend { font-weight: 700; font-size: 16px; margin-bottom: 18px; }
  .glossary-layout fieldset label { display: flex; align-items: center; gap: 10px; margin-bottom: 18px; font-size: 15px; cursor: pointer; }
  .glossary-layout input[type="radio"] { width: 17px; height: 17px; accent-color: #008c89; flex-shrink: 0; }
  .glossary-alphabet { display: grid; grid-template-columns: repeat(6,minmax(0,1fr)); gap: 6px; }
  .glossary-alphabet button { height: 40px; border: 1px solid #d2d6d7; border-radius: 0; background: white; color: #000d10; font: inherit; font-size: 14px; cursor: pointer; }
  .glossary-alphabet button:hover { border-color: var(--color-tiffany-blue); }
  .glossary-alphabet button[aria-pressed="true"] { background: var(--color-tiffany-blue); border-color: var(--color-tiffany-blue); }
  .glossary-empty { padding: 32px 0; border-top: 1px solid #d2d6d7; }
  .glossary-summary { margin-bottom: 24px; }
  .glossary-list h3 a { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; }
  .glossary-list h3 a:hover { color: #007c7a; }
  .glossary-list h3 a span { color: #007c7a; font-size: 22px; }
  .glossary-list p { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .glossary-list small { display: block; font-size: 12px; color: var(--color-slate-mist); margin-top: 12px; }
  .without-filters { grid-template-columns: minmax(0,1fr); }
  @media(max-width: 900px) { .glossary-layout:not(.without-filters) { gap: 32px; grid-template-columns: minmax(0,1fr) 240px; } }
  @media(max-width: 760px) { .glossary-layout {display: flex;flex-direction: column;gap:32px;} .glossary-filters {position: static;order: -1;width: 100%;} .glossary-results {width: 100%;} .glossary-list li {grid-template-columns: minmax(0,1fr);gap: 8px;} .glossary-layout h3 {font-size: 23px;} .glossary-alphabet {grid-template-columns: repeat(9,minmax(0,1fr));} }
</style>