---
import { text, htmlAttrs, attrs, imageAttrs } from "../utils/i18n";

const { eyebrow, title, body, image, alt, light = true, contrast = false } = Astro.props;
const classes = [
  "page-hero",
  light ? "page-hero-light" : "",
  image ? "page-hero-image" : "",
  contrast ? "page-hero-contrast" : ""
].filter(Boolean).join(" ");
---

<section class={classes} aria-labelledby="page-title">
  {image && <img src={image} {...imageAttrs(alt)} />}
  {image && <div class="page-hero-scrim"></div>}
  <div>
    {eyebrow && <p class="eyebrow" {...attrs(eyebrow)}>{text(eyebrow)}</p>}
    <h1 id="page-title" set:html={text(title)} {...htmlAttrs(title)} />
    {body && <p set:html={text(body)} {...htmlAttrs(body)} />}
  </div>
</section>
