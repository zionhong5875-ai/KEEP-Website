---
import { text, htmlAttrs, attrs } from "../utils/i18n";

const { eyebrow, title, body, image, alt, light = true } = Astro.props;
const classes = ["page-hero", light ? "page-hero-light" : "", image ? "page-hero-image" : ""].filter(Boolean).join(" ");
---

<section class={classes} aria-labelledby="page-title">
  {image && <img src={image} alt={alt} />}
  {image && <div class="page-hero-scrim"></div>}
  <div>
    {eyebrow && <p class="eyebrow" {...attrs(eyebrow)}>{text(eyebrow)}</p>}
    <h1 id="page-title" set:html={text(title)} {...htmlAttrs(title)} />
    {body && <p {...attrs(body)}>{text(body)}</p>}
  </div>
</section>
