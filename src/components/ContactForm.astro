---
---

<section class="contact section-pad" id="contact" aria-labelledby="contact-title">
  <div>
    <p class="section-kicker" data-zh="开始简报" data-en="Start a brief">开始简报</p>
    <h2
      id="contact-title"
      data-zh="告诉我们场景、接触面和使用频次，方案会更准确。"
      data-en="Tell us the environment, contact surface, and usage frequency so we can shape a sharper proposal."
    >
      告诉我们场景、接触面和使用频次，方案会更准确。
    </h2>
  </div>
  <form class="contact-form" data-contact-form>
    <label for="contact-name"><span data-zh="姓名" data-en="Name">姓名</span></label>
    <input id="contact-name" name="name" type="text" autocomplete="name" required />

    <label for="contact-email"><span data-zh="邮箱" data-en="Email">邮箱</span></label>
    <input id="contact-email" name="email" type="email" autocomplete="email" required />

    <label for="contact-company"><span data-zh="公司" data-en="Company">公司</span></label>
    <input id="contact-company" name="company" type="text" autocomplete="organization" />

    <label for="contact-need"><span data-zh="需求类型" data-en="Request type">需求类型</span></label>
    <select id="contact-need" name="need">
      <option value="" data-zh="请选择" data-en="Please select">请选择</option>
      <option value="medikeep">MEDIKEEP</option>
      <option value="carekeep">CAREKEEP</option>
      <option value="indukeep">INDUKEEP</option>
      <option value="oem" data-zh="OEM / 定制" data-en="OEM / Custom">OEM / 定制</option>
    </select>

    <label for="contact-message"><span data-zh="项目说明" data-en="Project brief">项目说明</span></label>
    <textarea
      id="contact-message"
      name="message"
      rows="5"
      data-placeholder-zh="例如：目标市场、使用场景、包装形式、法规要求。"
      data-placeholder-en="For example: target market, environment, package format, and regulatory requirements."
      placeholder="例如：目标市场、使用场景、包装形式、法规要求。"
    ></textarea>

    <button class="button button-accent" type="submit" data-zh="发送需求" data-en="Send brief">发送需求</button>
    <p class="form-status" data-contact-status aria-live="polite"></p>
  </form>
</section>
