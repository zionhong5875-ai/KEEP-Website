---
import { text, attrs } from "../utils/i18n";
import { contactFields } from "../utils/contact-fields.mjs";

const {
  kicker = {
    zh: "联系表单",
    en: "Contact Form"
  }
} = Astro.props;
---

<section class="contact section-pad" id="contact" aria-labelledby="contact-title">
  <div>
    <p class="section-kicker" {...attrs(kicker)}>{text(kicker)}</p>
    <h2
      id="contact-title"
      data-zh="您提出的需求越具体，<br />我们的方案越精准。"
      data-en="The more specific your requirements,<br />the more precise our solution."
      data-i18n-html="true"
    >
      您提出的需求越具体，<br />我们的方案越精准。
    </h2>
    <p
      class="contact-email"
      data-zh="邮箱：hongzihao@vinnercare.cn"
      data-en="Email: hongzihao@vinnercare.cn"
    >
      邮箱：hongzihao@vinnercare.cn
    </p>
  </div>
  <form class="contact-form" data-contact-form enctype="multipart/form-data">
    <div class="contact-fields">
    {contactFields.filter(field => field.type !== "textarea").map(field => (
      <label class="contact-field" for={`contact-${field.name}`}>
        <span data-zh={`${field.zh}${field.optional ? "" : " *"}`} data-en={`${field.en}${field.optional ? "" : " *"}`}>{field.zh}{field.optional ? "" : " *"}</span>
        {field.options ? (
          <select id={`contact-${field.name}`} name={field.name} required>
            <option value="" data-zh="请选择" data-en="Please select">请选择</option>
            {field.options.map(item => <option value={item.value} {...attrs(item)}>{item.zh}</option>)}
          </select>
        ) : (
          <input id={`contact-${field.name}`} name={field.name} type={field.type || "text"} autocomplete={field.autocomplete} maxlength={field.limit} required={!field.optional} placeholder={field.type === "url" ? "https://" : undefined} />
        )}
      </label>
    ))}
    </div>
    <div class="contact-description" data-contact-dropzone>
    <label class="contact-field" for="contact-message">
      <span data-zh="产品描述 *" data-en="Product description *">产品描述 *</span>
      <textarea
        id="contact-message"
        name="message"
        rows="3" required maxlength="5000" aria-describedby="contact-file-help"
        data-placeholder-zh="请说明产品功能、尺寸要求、抽数要求、包装形式、法规要求、是否已有相关检测报告或需维尼满足的测试要求，若您需要投标，则可直接发送标书。"
        data-placeholder-en="Describe product function, dimensions, wipe count, packaging, regulations, existing test reports or tests required of Vinner. For tenders, you may attach the tender document."
        placeholder="请说明产品功能、尺寸要求、抽数要求、包装形式、法规要求、是否已有相关检测报告或需维尼满足的测试要求，若您需要投标，则可直接发送标书。"
      ></textarea>
    </label>
    <p id="contact-file-help" class="contact-file-help" data-zh="可将 PDF 拖入此处，或点击上传文件（最多 3 个，合计 4 MB）" data-en="Drop PDFs here or upload files (up to 3 files, 4 MB total)">可将 PDF 拖入此处，或点击上传文件（最多 3 个，合计 4 MB）</p>
    </div>
    <div class="contact-files" data-contact-files aria-live="polite"></div>
    <input type="file" accept=".pdf,application/pdf" multiple data-contact-file-input hidden aria-label="PDF attachments" />
    <input class="contact-form-trap" name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <div class="button-row contact-actions">
    <button class="button button-dark" type="button" data-contact-upload data-zh="上传文件" data-en="Upload files">上传文件</button>
    <button class="button button-accent" type="submit" data-zh="发送需求" data-en="Send brief">发送需求</button>
    </div>
    <p class="form-status" data-contact-status aria-live="polite"></p>
  </form>
</section>

<script>
  import "../scripts/contact-form.js";
</script>
