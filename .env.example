# Public site settings
PUBLIC_SITE_URL=https://example.com

# Contact form email delivery through Resend
RESEND_API_KEY=
CONTACT_FROM=KEEP Website <noreply@example.com>
CONTACT_TO=sales@example.com

# Feishu / Lark Bitable storage
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=

# Optional: Feishu webhook notification, if you want instant alerts in a group chat
FEISHU_WEBHOOK_URL=
