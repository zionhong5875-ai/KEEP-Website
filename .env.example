# Public site settings
PUBLIC_SITE_URL=https://keep-website-ochre.vercel.app

# CMS GitHub OAuth login for /admin/
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
# Optional: lock OAuth tokens to this repository ID.
OAUTH_GITHUB_REPO_ID=
PUBLIC_DECAP_CMS_VERSION=3.11.0

# Contact form email delivery through Resend
RESEND_API_KEY=
CONTACT_FROM=VINNER Website <noreply@vinnercare.cn>
CONTACT_TO=hongzihao@vinnercare.cn

# Feishu / Lark Bitable storage
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=

# Optional: Feishu webhook notification, if you want instant alerts in a group chat
FEISHU_WEBHOOK_URL=
